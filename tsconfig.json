/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "types": ["jquery"],
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "paths": {
      "@/*": ["./src/app/*"],
      "@components/*": ["./src/app/shared/components/*"],
      "@environments": ["./src/environments/environment"],
      "@services/request": ["./src/app/core/services/request/request.service"],
      "@services/likes": ["./src/app/core/services/likes/likes.service"],
      "@services/query": ["./src/app/core/services/query/query.service"],
      "@services/toast": ["./src/app/core/services/toast/toast.service"],
      "@services/comments": ["./src/app/core/services/comments/comments.service"],
      "@services/chat": ["./src/app/core/services/chat/chat.service"],
      "@services/auth": ["./src/app/core/services/auth/auth.service"],
      "@services/crypto": ["./src/app/core/services/crypto/crypto.service"],
      "@services/agency-access": ["./src/app/core/services/agency-access.service"],
      "@services/interfaces": ["./src/app/core/interfaces/common.interface"],
      "@services/webSocket": ["./src/app/core/services/webSocket/web-socket.service"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
